ASSISTANT_API_KEY=your-llm-api-key
ASSISTANT_BASE_URL=https://your-llm-endpoint/v1
ASSISTANT_MODEL=your-model

# DuckDuckGo circuit breaker: skip DDG after N blocking failures, then use Tavily + Exa
ASSISTANT_SEARCH_DDG_FAILURE_THRESHOLD=5
ASSISTANT_SEARCH_DDG_BLOCKED_SIGNATURE=TLS close_notify

TAVILY_API_KEY=your-tavily-api-key
EXA_API_KEY=your-exa-api-key
EXCHANGERATE_API_KEY=your-exchangerate-api-key

# ── Persistence (PostgreSQL + Redis via Docker) ────────────────────────────────
# ASSISTANT_USE_DB=1 stores state in PostgreSQL + Redis (run: docker compose up -d).
# ASSISTANT_USE_DB=0 (default) keeps using local JSON files under data/.
ASSISTANT_USE_DB=0

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=assistant
POSTGRES_PASSWORD=change-me
POSTGRES_DB=assistant

REDIS_HOST=localhost
REDIS_PORT=6379
